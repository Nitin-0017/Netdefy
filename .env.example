# NETDEFY Environment Configuration Template
# Copy this file to .env and adjust values for local development.

# Application Environment (development, staging, production)
NETDEFY_ENV=development

# Path to master configuration YAML
NETDEFY_CONFIG_PATH=configs/config.yaml

# Hardware Device Preference: 'auto', 'cuda', 'mps', or 'cpu'
NETDEFY_DEVICE_PREFERENCE=auto

# Logging Configuration
NETDEFY_LOG_LEVEL=INFO
NETDEFY_LOG_FILE=reports/netdefy.log

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=netdefy-anomaly-detection

# Backend Inference Server (Phase 3+)
API_HOST=127.0.0.1
API_PORT=8000

