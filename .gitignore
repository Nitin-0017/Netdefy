# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Datasets (never commit raw or processed datasets, preserve structure via README.md/.gitkeep)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/external/*
!data/external/.gitkeep
!data/external/README.md
data/interim/*
!data/interim/.gitkeep
!data/interim/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
# Benchmark Datasets (v1 is tracked: Parquets & large manifests via Git LFS, metadata via normal Git)
# Unversioned or temporary benchmark scratch files remain excluded
data/benchmark/*
!data/benchmark/.gitkeep
!data/benchmark/README.md
!data/benchmark/v1/
!data/benchmark/phase5_1/
data/benchmark/phase5_1/*.parquet

# Artifacts & Checkpoints
# Exclude temporary checkpoints and unversioned scratch model dumps
checkpoints/
*.pt
*.pth
*.onnx
*.pkl

# Preserve versioned model and preprocessing artifacts
# (Binary .joblib and .pt files in artifacts/ are tracked via Git LFS in .gitattributes)
artifacts/*
!artifacts/.gitkeep
!artifacts/README.md
!artifacts/preprocessing/
!artifacts/models/
!artifacts/models/**/*.pt
!artifacts/models/**/*.joblib

# MLflow Experiment Tracking
mlruns/
mlartifacts/

# Logs & Diagnostics
*.log
logs/

# Testing & Quality Assurance
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# macOS & OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

